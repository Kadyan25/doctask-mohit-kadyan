# Postgres (used by docker-compose to configure the db service)
POSTGRES_USER=docdesk
POSTGRES_PASSWORD=docdesk
POSTGRES_DB=docdesk

# DATABASE_URL is set automatically by docker-compose for the backend container.
# Override here only if running the backend outside compose (e.g. against your own local Postgres with pgvector installed).
# DATABASE_URL=postgresql+psycopg://docdesk:docdesk@localhost:5433/docdesk

# "fake" runs the whole pipeline with a deterministic stub LLM (no key, no cost) — used by the test suite
# and safe as the default so a stranger can run this with zero setup. Swap to a real provider name to use real calls.
LLM_PROVIDER=fake
LLM_API_KEY=

DOCUMENT_STORAGE_PATH=/data/documents
WATCH_FOLDER_PATH=/data/watch
MCP_SERVER_PORT=8001
APP_PORT=8000
