# Postgres (used by docker-compose to configure the db service)
POSTGRES_USER=docdesk
POSTGRES_PASSWORD=docdesk
POSTGRES_DB=docdesk

# DATABASE_URL is set automatically by docker-compose for the backend container.
# Override here only if running the backend outside compose (e.g. against your own local Postgres with pgvector installed).
# DATABASE_URL=postgresql+psycopg://docdesk:docdesk@localhost:5433/docdesk

# "fake" is the env-level default (LLM_PROVIDER=fake, no key, no cost) — used by the test suite and safe
# as the default so a stranger can run this with zero setup. The frontend's per-run provider dropdown can
# switch to "gemini" or "anthropic" without changing this. "gemini" defaults to gemini-2.5-flash-lite and
# self-paces to its free-tier rate limit (15 RPM per key; two keys round-robin for ~2x effective throughput),
# so no billing is required to demo real AI extraction. GEMINI_API_KEY_2 is optional.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=

DOCUMENT_STORAGE_PATH=/data/documents
WATCH_FOLDER_PATH=/data/watch
MCP_SERVER_PORT=8001
APP_PORT=8000
